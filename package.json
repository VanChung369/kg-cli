{
  "name": "kg-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Local knowledge graph CLI for TypeScript, NestJS, and Next.js projects",
  "type": "module",
  "bin": {
    "kg": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "start": "node dist/cli.js",
    "prepack": "npm run build",
    "pack:dry": "npm pack --dry-run",
    "link:global": "npm link"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "chokidar": "^5.0.0",
    "commander": "^14.0.0",
    "fast-glob": "^3.3.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
